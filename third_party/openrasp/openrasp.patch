+function has_traversal (path) {
+
+    // 左右斜杠，一视同仁
+    var path2 = "/" + path.replaceAll('\\', '/') + "/"
+    // 覆盖 ../../
+    // 以及 /../../
+    var left  = path2.indexOf('/../')
+    var right = path2.lastIndexOf('/../')
+
+    if (left != -1 && right != -1 && left != right)
+    {
+        return true
+    }
+
+    return false
+}
