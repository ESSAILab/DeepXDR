+                    }
+                }
+            }
+
+            if (reason !== false && !sqliWhiteManager.test(params.stack[0])) 
+            {
+                return {
+                    action:     algorithmConfig.sql_policy.action,
+                    message:    reason,
+                    confidence: 100,
