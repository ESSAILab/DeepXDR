+function is_method_from_rasp(stack) {
+    // 检查栈顶 -> rasp堆栈之间，是否包含用户代码，即非 JDK相关的函数
+    for (; i < stacks.length; i ++) {
+        var method = stacks[i]                
+        if (! method.startsWith('java.') 
+            && !method.startsWith('sun.') 
+            && !method.startsWith('com.sun.'))
+        {
+            return false
+        }
+    }
+    return true
+}
