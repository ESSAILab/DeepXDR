+                        confidence: 90,
+                        algorithm:  'readFile_userinput_http'
+                    }
+                }
+            }
+
+            // 2. 读取特殊协议内容
+            // ?file=file:///etc/passwd
+            // ?file=php://filter/read=convert.base64-encode/resource=XXX
+            if (proto === 'file' || proto === 'php')
+            {
+                if (algorithmConfig.readFile_userinput_unwanted.action != 'ignore')
+                {
