+        var parameters      = context.parameter || {}
+        var json_parameters = context.json || {}
+        var raw_tokens      = []
+
+        function _run(values, name) {
+            var reason = false
+            values.some(function (value) {
+                // 不处理3维及以上的数组
+                if (typeof value != "string") {
+                    return false
+                }
