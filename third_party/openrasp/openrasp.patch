+    // http://2130706433
+    // http://0x7f001
+    //
+    // 以下混淆方式没有检测，容易误报
+    // http://0x7f.0x0.0x0.0x1
+    // http://0x7f.0.0.0
+    if (algorithmConfig.ssrf_obfuscate.action != 'ignore')
