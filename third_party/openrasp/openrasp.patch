+                    // 1.0 Rhino 引擎不支持URL对象，考虑到 1.0 用户不多，先简单处理下
+                    var content_type = header["content-type"] || ""
+                    if (content_type.indexOf("xml") != -1 || is_include_in_userinput(parameters, address)) {
+                        // 过滤掉 xml、dtd、xsd
+                        if (! address_lc.endsWith('.xml') &&
