+AlarmLogMode = es
+AlarmBufferSize = 300
+; AlarmCheckInterval unit second
+; AlarmCheckInterval = 120
+; CookieLifeTime unit hour
+CookieLifeTime = 168
+; EsTTL unit day
+EsTTL = 365
+; whether request body
+RequestBodyEnable = false
+; whether enable debug mode
+DebugModeEnable = false
+; whether error log
