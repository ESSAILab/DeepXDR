+    if (algorithmConfig.readFile_userinput.action != 'ignore')
+    {
+        var all_parameter = get_all_parameter(context)
+
+        // ?path=/etc/./hosts
+        // ?path=../../../etc/passwd
+        if ( (proto == "" || proto == "file" ) && 
