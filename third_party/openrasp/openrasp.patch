diff --git a/rasp-cloud-docker/Dockerfile b/rasp-cloud-docker/Dockerfile
new file mode 100644
index 00000000..35b86bad
--- /dev/null
+++ b/rasp-cloud-docker/Dockerfile
@@ -0,0 +1,15 @@
+FROM alpine:3.18
+
+WORKDIR /app
+
+# 安装必要的glibc兼容层
+RUN apk add --no-cache libc6-compat gcompat
+
+# 拷贝当前目录所有文件到容器/app目录
+COPY . /app
+
+# 设置执行权限
+RUN chmod +x /app/rasp-cloud
+
+# 启动应用
+CMD ["./rasp-cloud"]
