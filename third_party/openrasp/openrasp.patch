+            }
+
+            var features        = algorithmConfig.sql_policy.feature
+            var func_list       = algorithmConfig.sql_policy.function_blacklist
+            var func_count_list = algorithmConfig.sql_policy.function_count
+
+            // 黑名单函数计数
