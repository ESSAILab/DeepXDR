+
+        if (!isNaN(hostname) && hostname.length != 0)
+        {
+            reason = _("SSRF - Requesting numeric IP address: %1%", [hostname])
+        }
+        // else if (hostname.startsWith('0x') && hostname.indexOf('.') === -1)
+        // {
+        //     reason = _("SSRF - Requesting hexadecimal IP address: %1%", [hostname])
+        // }
