+                confidence: 90,
+                algorithm: 'readFile_userinput'
+            }
+        }
+        // @FIXME: 用户输入匹配了两次，需要提高效率
+        if (is_from_userinput(parameter, params.path))
+        {
+            // 获取协议，如果有
+            var proto = params.path.split('://')[0].toLowerCase()
+            // 1. 读取 http(s):// 内容
+            // ?file=http://www.baidu.com
+            if (proto === 'http' || proto === 'https')
+            {
