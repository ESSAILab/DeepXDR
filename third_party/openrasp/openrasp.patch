@@ -24,12 +24,27 @@ import com.baidu.openrasp.tool.StackTrace;
 import com.baidu.openrasp.tool.annotation.HookAnnotation;
 import javassist.CannotCompileException;
 import javassist.CtClass;
+import javassist.CtMethod;
 import javassist.NotFoundException;
 
 import java.io.File;
 import java.io.IOException;
+import java.io.UnsupportedEncodingException;
+import java.nio.charset.StandardCharsets;
 import java.util.HashMap;
 import java.util.List;
+import java.io.FileInputStream;
+import java.io.RandomAccessFile;
+import java.util.Arrays;
+import com.baidu.openrasp.messaging.LogTool;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.lang.reflect.Array;
+import java.lang.reflect.Method;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.util.Arrays;
 
 /**
  * Created by lxk on 6/8/17.
@@ -65,22 +80,109 @@ public class FileOutputStreamHook extends AbstractClassHook {
      */
     @Override
     protected void hookMethod(CtClass ctClass) throws IOException, CannotCompileException, NotFoundException {
+        // 构造函数钩子
         String src = getInvokeStaticSrc(FileOutputStreamHook.class, "checkWriteFile", "$1", File.class);
         insertBefore(ctClass.getConstructor("(Ljava/io/File;Z)V"), src);
+        
+        // 添加write方法钩子 - 处理所有重载版本
+        // 1. write(byte[] b)
+        //CtMethod writeMethod1 = ctClass.getMethod("write", "([B)V");
+        //String writeSrc1 = getInvokeStaticSrc(FileOutputStreamHook.class, "checkWriteFile", "$1", byte[].class);
+        //insertBefore(writeMethod1, writeSrc1);
+        
+        // 2. write(byte[] b, int off, int len)
+        CtMethod writeMethod2 = ctClass.getMethod("write", "([BII)V");
+        String writeSrc2 = getInvokeStaticSrc(FileOutputStreamHook.class, "checkWriteFileWithOffset", "$1,$2,$3", byte[].class, int.class, int.class);
+        //insertAfter(ctClass, "write", "([BII)V", writeSrc2, false);
+        //insertBefore(ctClass, "write", "([BII)V", writeSrc2);
     }
 
     /**
-     * 写文件hook点
+     * 写文件hook点 - 通过构造函数调用
      *
      * @param file
      */
     public static void checkWriteFile(File file) {
         if (file != null) {
+            LogTool.traceInfo("FileOutputStreamHook.checkWriteFile(File) called with path: " + file.getPath());
+
             HashMap<String, Object> params = new HashMap<String, Object>();
             params.put("path", file.getPath());
             params.put("realpath", FileUtil.getRealPath(file));
             List<String> stackInfo = StackTrace.getParamStackTraceArray();
             params.put("stack", stackInfo);
+
+            // 使用直接IO操作读取文件内容，保留上下文标记逻辑
+            try {
+                byte[] contentBytes = new byte[0];
+                FileInputStream fis = null;
+                try {
+                    // 设置写入上下文标记，屏蔽FileInputStream事件
+                    FileInputStreamHook.setInWriteContext(true);
+
+                    fis = new FileInputStream(file);
+                    contentBytes = new byte[4 * 1024]; // 限制4KB
+                    int bytesRead = fis.read(contentBytes);
+                    if (bytesRead < 0) {
+                        contentBytes = new byte[0]; // 文件为空
+                    } else if (bytesRead < contentBytes.length) {
+                        contentBytes = Arrays.copyOf(contentBytes, bytesRead);
+                    }
+                } finally {
+                    // 清除写入上下文标记
+                    FileInputStreamHook.setInWriteContext(false);
+                    if (fis != null) {
+                        try {
+                            fis.close();
+                        } catch (IOException e) {
+                            LogTool.traceHookWarn("Failed to close file input stream: " + e.getMessage(), e);
+                        }
+                    }
+                }
+                params.put("content", new String(contentBytes, "UTF-8"));
+            } catch (IOException e) {
+                LogTool.traceHookWarn("Failed to read file content: " + e.getMessage(), e);
+                params.put("content", "");
+            }
+
+            HookHandler.doCheck(CheckParameter.Type.WRITEFILE, params);
+        }
+    }
+    
+    /**
+     * 写文件hook点 - 通过write(byte[] b, int off, int len)方法调用
+     *
+     * @param contentBytes 字节数组
+     * @param off 起始偏移量
+     * @param len 写入长度
+     */
+    public static void checkWriteFileWithOffset(byte[] contentBytes, int off, int len) {
+        if (contentBytes != null && len > 0 && off >= 0 && off + len <= contentBytes.length) {
+            LogTool.traceInfo("FileOutputStreamHook.checkWriteFileWithOffset called with content length: " + len);
+            // 截取实际写入的字节数组片段
+            byte[] actualBytes = Arrays.copyOfRange(contentBytes, off, off + len);
+            checkWriteFile(actualBytes); // 复用现有byte[]处理逻辑
+        } else {
+            //LogTool.traceHookWarn("Failed to checkWriteFileWithOffset");
+            //LogTool.traceWarn(ErrorType.HOOK_ERROR, "Invalid parameters for write method: contentBytes.length=" + (contentBytes != null ? contentBytes.length : "null") + ", off=" + off + ", len=" + len);
+        }
+    }
+    
+    /**
+     * 写文件hook点 - 通过write方法调用
+     *
+     * @param contentBytes
+     */
+    public static void checkWriteFile(byte[] contentBytes) {
+        if (contentBytes != null) {
+            LogTool.traceInfo("FileOutputStreamHook.checkWriteFile(byte[]) called with content length: " + contentBytes.length);
+            HashMap<String, Object> params = new HashMap<String, Object>();
+            // 注意：此处无法获取文件路径信息
+            params.put("content", new String(contentBytes, StandardCharsets.UTF_8));
+            params.put("path", "unknown"); // 添加默认path值避免NPE
+            params.put("realpath", "unknown"); // 添加默认realpath值避免NPE
+            List<String> stackInfo = StackTrace.getParamStackTraceArray();
+            params.put("stack", stackInfo);
             HookHandler.doCheck(CheckParameter.Type.WRITEFILE, params);
         }
     }
