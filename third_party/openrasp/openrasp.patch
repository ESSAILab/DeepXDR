+String.prototype.replaceAll = function(token, tokenValue) {
+    // 空值判断，防止死循环
+    if (! token || token.length == 0) {
+        return this
+    }
+
+    var index  = 0;
+    var string = this;
+
+    do {
+        string = string.replace(token, tokenValue);
+    } while((index = string.indexOf(token, index)) > -1);
