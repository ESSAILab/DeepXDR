+    // 覆盖 ../../
+    // 以及 /../../
+    var left  = path2.indexOf('/../')
+    var right = path2.lastIndexOf('/../')
+
+    if (left != -1 && right != -1 && left != right)
+    {
+        return true
+    }
+
+    return false
+}
