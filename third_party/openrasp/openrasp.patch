+// 下个版本将会支持翻译，目前还需要暴露一个 getText 接口给插件
+function _(message, args) 
+{
+    args = args || []
+
+    for (var i = 0; i < args.length; i ++) 
+    {
+        var symbol = '%' + (i + 1) + '%'
+        message = message.replace(symbol, args[i])
+    }
+
+    return message
+}
