+function is_absolute_path(path, is_windows) {
+
+    // Windows - C:\\windows
+    if (is_windows) {
+
+        if (path[1] == ':')
+        {
+            var drive = path[0].toLowerCase()
+            if (drive >= 'a' && drive <= 'z')
+            {
+                return true
+            }
+        }
+    }
+
+    // Unices - /root/
+    return path[0] === '/'
+}
