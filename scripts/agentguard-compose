#!/usr/bin/env python3
"""Validate AgentGuard host roots, then invoke the available Compose CLI."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

from agentguard_path_policy import validate_agentguard_roots


REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_COMPOSE_FILE = (REPO_ROOT / "deploy" / "docker-compose-agentguard.yml").resolve()
ALL_IN_ONE_COMPOSE_FILE = (REPO_ROOT / "deploy" / "docker-compose-agent-all-in-one.yml").resolve()
ALLOWED_COMPOSE_FILES = {DEFAULT_COMPOSE_FILE, ALL_IN_ONE_COMPOSE_FILE}


def resolve_compose_file(configured_file: str | None) -> Path:
    if not configured_file:
        return DEFAULT_COMPOSE_FILE

    candidate = Path(configured_file)
    if not candidate.is_absolute():
        candidate = REPO_ROOT / candidate
    compose_file = candidate.resolve()
    if compose_file not in ALLOWED_COMPOSE_FILES:
        raise ValueError(f"Unsupported AgentGuard Compose file: {configured_file}")
    return compose_file


def main(argv: list[str] | None = None) -> int:
    workspace_root, state_root = validate_agentguard_roots(
        workspace_root=os.getenv("AGENTGUARD_WORKSPACE_ROOT"),
        state_root=os.getenv("AGENTGUARD_NONO_STATE_ROOT"),
    )
    env = os.environ.copy()
    env.update(
        {
            "AGENTGUARD_WORKSPACE_ROOT": str(workspace_root),
            "AGENTGUARD_NONO_STATE_ROOT": str(state_root),
            "AGENTGUARD_PATHS_VALIDATED": "1",
        }
    )
    compose_file = resolve_compose_file(os.getenv("AGENTGUARD_COMPOSE_FILE"))
    arguments = list(sys.argv[1:] if argv is None else argv)

    docker = shutil.which("docker")
    if docker:
        probe = subprocess.run(
            [docker, "compose", "version"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if probe.returncode == 0:
            os.execve(docker, [docker, "compose", "-f", str(compose_file), *arguments], env)

    legacy_compose = shutil.which("docker-compose")
    if legacy_compose:
        os.execve(legacy_compose, [legacy_compose, "-f", str(compose_file), *arguments], env)

    print("Neither 'docker compose' nor 'docker-compose' is available.", file=sys.stderr)
    return 127


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ValueError as exc:
        print(f"AgentGuard path validation failed: {exc}", file=sys.stderr)
        raise SystemExit(2) from None
